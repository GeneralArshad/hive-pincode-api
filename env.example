# ============================================================
# Hive Frontline Pincode API — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
# Get this from: MongoDB Atlas → Connect → Drivers → Copy connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/hive-pincode?retryWrites=true&w=majority

# Email notifications (optional — works without this, just logs to console)
# For Office 365 / Outlook:
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USER=arshad@britishbiologicals.com
EMAIL_PASS=your-app-password-here
NOTIFY_EMAIL=arshad@britishbiologicals.com

# Server port (Render will set this automatically)
PORT=3001
